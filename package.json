{
  "name": "dsh-direnv",
  "version": "0.1.0-alpha.2",
  "description": "Load each workspace's direnv environment into every command the DeepSeek Harness runs — automatically, per working directory. 让 DSH 每个工作区的子进程自动带上该工作区的 direnv 环境。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Snowy117/dsh-direnv.git"
  },
  "homepage": "https://github.com/Snowy117/dsh-direnv#readme",
  "bugs": {
    "url": "https://github.com/Snowy117/dsh-direnv/issues"
  },
  "author": "Snowy117",
  "type": "module",
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-subprocess-local": ">=0.1.7-rc.1 <0.3.0-0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "direnv",
    "envrc",
    "nix",
    "devshell"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:client",
    "build:client": "esbuild client/index.ts --bundle --format=iife --target=es2020 --outfile=lib/client.js --log-level=warning",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json && tsc -p tsconfig.test.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test 'test/*.test.ts'",
    "test:client": "npm run build && node test/client-boot.ts",
    "test:harness": "test/harness/run.sh --all",
    "prepack": "npm run build"
  }
}
